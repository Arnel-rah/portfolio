---
interface Props {
  title: string;
  description?: string;
}
const { 
  title, 
  description = "Willys Sadi Arnel — Junior Backend & Cloud Automation Engineer based in Madagascar." 
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 font-sans antialiased selection:bg-teal-500/20 selection:text-teal-700 dark:selection:text-teal-300 min-h-screen">
  <div class="max-w-2xl mx-auto px-5 sm:px-6 py-10 sm:py-16">
    <slot />
  </div>
</body>
</html>

<style is:global>
  @import "tailwindcss";
</style>