---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "RAHARINANDRASANA Willys Sadi Arnel — Backend & Cloud Automation Engineer based in Madagascar.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://arnel.dev");
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f5ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111827" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body
    class="min-h-dvh overflow-x-hidden bg-[#f7f5ef] text-slate-900 antialiased transition-colors duration-200 selection:bg-orange-200 selection:text-slate-950 dark:bg-[#111827] dark:text-slate-100 dark:selection:bg-orange-900 dark:selection:text-white"
  >
    <main class="mx-auto w-full max-w-4xl px-4 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-3 sm:px-8 sm:pb-16 sm:pt-6">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  @font-face {
    font-family: "Geist Pixel Grid";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/GeistPixel-Grid.woff2") format("woff2");
  }

  html {
    font-family: "Manrope", sans-serif;
    -webkit-text-size-adjust: 100%;
  }

  body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Geist", sans-serif;
  }

  .hero-name {
    font-family: "Geist Pixel Grid", "Geist Mono", monospace;
    font-size: clamp(1.5rem, 8vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    width: 100%;
  }

  .section-title {
    font-family: "Geist Pixel Grid", "Geist Mono", monospace;
    font-size: clamp(1.375rem, 6vw, 1.875rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .nav-name {
    font-family: "Geist Pixel Grid", "Geist Mono", monospace;
    font-size: clamp(1rem, 4vw, 1.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  @media (max-width: 479px) {
    .hero-layout {
      flex-direction: column;
    }

    .hero-avatar {
      display: none;
    }

    .hero-layout > .min-w-0 {
      width: 100%;
    }
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 3px;
  }
</style>