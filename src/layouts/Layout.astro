---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "RAHARINANDRASANA Willys Sadi Arnel — DevOps & Cloud Engineer based in Madagascar, available for remote freelance work.",
  image,
} = Astro.props;

const siteURL = Astro.site || "https://arnel.dev";
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = image ? new URL(image, siteURL) : undefined;

const fontsHref =
  "https://fonts.googleapis.com/css2?family=Geist:wght@500..700&family=JetBrains+Mono:wght@400..600&family=Manrope:wght@400..700&display=swap";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f5ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111827" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Thème appliqué avant le premier affichage (évite le flash) -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          var stored = localStorage.getItem("theme");
          dark =
            stored === "dark" ||
            (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        } catch (e) {
          dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        }
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>

    <!-- Polices -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/GeistPixel-Grid.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Chargé sans bloquer l'affichage -->
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
  </head>

  <body
    class="min-h-dvh overflow-x-hidden bg-[#f7f5ef] text-slate-900 antialiased transition-colors duration-200 selection:bg-orange-200 selection:text-slate-950 dark:bg-[#111827] dark:text-slate-100 dark:selection:bg-orange-900 dark:selection:text-white"
  >
    <main class="mx-auto w-full max-w-4xl px-4 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-3 sm:px-8 sm:pb-16 sm:pt-6">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  @theme {
    --font-sans: "Manrope", ui-sans-serif, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  @font-face {
    font-family: "Geist Pixel Grid";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/GeistPixel-Grid.woff2") format("woff2");
  }

  html {
    font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Geist", ui-sans-serif, system-ui, sans-serif;
  }

  .hero-name {
    font-family: "Geist Pixel Grid", "JetBrains Mono", monospace;
    font-size: clamp(1.5rem, 8vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    width: 100%;
  }

  .section-title {
    font-family: "Geist Pixel Grid", "JetBrains Mono", monospace;
    font-size: clamp(1.625rem, 7vw, 1.875rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .nav-name {
    font-family: "Geist Pixel Grid", "JetBrains Mono", monospace;
    font-size: clamp(1.0625rem, 4.5vw, 1.25rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  @media (max-width: 479px) {
    .hero-layout {
      flex-direction: column;
    }

    .hero-avatar {
      display: none;
    }

    .hero-layout > .min-w-0 {
      width: 100%;
    }
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 3px;
  }
</style>