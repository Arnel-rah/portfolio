---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import InfoRow from "../components/InfoRow.astro";
import { Icon } from "astro-icon/components";

const intro = [
  "I'm a junior SysOps engineer based in Antananarivo, Madagascar, with a focus on Linux administration and operational automation.",
  "I work with containers, shell scripts, infrastructure-as-code, CI/CD pipelines, system monitoring, and application delivery. My goal is to make environments reproducible, documented, and easier to operate.",
  "I replace repetitive manual work with small, reliable tools and versioned procedures. I also use GitHub to build in public and keep my operational work reviewable.",
];

const services = [
  {
    title: "Linux & systems",
    text: "Linux environment setup, package management, users and permissions, services, logs, networking checks, and repeatable shell automation.",
  },
  {
    title: "Containers & delivery",
    text: "Dockerized workloads, Compose environments, container lifecycle automation, and GitHub Actions pipelines for build, test, and deployment.",
  },
  {
    title: "Automation & IaC",
    text: "Terraform and scripts to reduce manual configuration, provision consistent environments, and document infrastructure changes.",
  },
  {
    title: "Monitoring & operations",
    text: "Go and Python operational tools, process and port checks, health endpoints, logs, backup procedures, and incident-oriented runbooks.",
  },
];

const principles = [
  "Make systems observable before adding complexity.",
  "Automate tasks that are repetitive, risky, or difficult to reproduce.",
  "Prefer least-privilege access, secure configuration, and documented recovery steps.",
  "Treat backups, logs, health checks, and rollback as first-class requirements.",
];

const stack = [
  { name: "Linux", icon: "lucide:terminal" },
  { name: "Terraform", icon: "simple-icons:terraform" },
  { name: "Docker", icon: "simple-icons:docker" },
  { name: "GitHub Actions", icon: "simple-icons:githubactions" },
  { name: "Bash", icon: "simple-icons:gnubash" },
  { name: "Go", icon: "simple-icons:go" },
  { name: "Python", icon: "simple-icons:python" },
];
---

<Layout title="About — RAHARINANDRASANA Willys Sadi Arnel">
  <Nav />

  <!-- About me -->
  <section class="mb-12 sm:mb-20">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h1 class="section-title text-slate-950 dark:text-white">About Me</h1>
    </div>

    <div class="max-w-2xl space-y-5 text-base leading-7 text-slate-700 text-pretty dark:text-slate-300 sm:space-y-4 sm:text-lg sm:leading-relaxed">
      {intro.map((paragraph) => (
        <div class="relative pl-5 font-mono sm:pl-6">
          <span class="absolute left-0 top-0 select-none font-mono text-[#b56f4a]">›</span>
          <p class="break-words">{paragraph}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What I do -->
  <section class="mb-12 sm:mb-20">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h2 class="section-title text-slate-950 dark:text-white">What I Do</h2>
    </div>

    <ul class="grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 sm:gap-y-6">
      {services.map((item) => (
        <li class="border-t border-slate-300 pt-4 dark:border-slate-700">
          <h3 class="font-mono text-lg font-semibold text-slate-950 dark:text-white">
            {item.title}
          </h3>
          <p class="mt-2 text-base leading-7 text-slate-600 dark:text-slate-400 sm:leading-relaxed">
            {item.text}
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-7 font-mono text-base text-slate-500 dark:text-slate-400">
      Real examples in{" "}
      <a href="/#projects" class="text-[#24302a] underline decoration-[#b56f4a] underline-offset-4 dark:text-[#edf1e8]">
        Featured Projects
      </a>.
    </p>
  </section>

  <!-- How I work -->
  <section class="mb-12 sm:mb-20">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h2 class="section-title text-slate-950 dark:text-white">How I Work</h2>
    </div>

    <ul class="max-w-2xl space-y-4 text-base leading-7 text-slate-700 dark:text-slate-300 sm:space-y-3 sm:text-lg sm:leading-relaxed">
      {principles.map((line) => (
        <li class="flex items-start gap-3 font-mono">
          <span class="shrink-0 select-none text-[#b56f4a]">›</span>
          <span class="min-w-0 break-words">{line}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Background -->
  <section class="mb-12 sm:mb-20">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h2 class="section-title text-slate-950 dark:text-white">Background</h2>
    </div>

    <dl class="space-y-4 font-mono sm:space-y-3">
      <div class="relative pl-3 font-mono sm:pl-4">
        <InfoRow label="Focus">
          <span class="break-words font-mono text-base font-semibold leading-7 text-slate-900 dark:text-white sm:text-lg">
            SysOps, Infrastructure Automation, Infrastructure as Code
          </span>
        </InfoRow>
      </div>
      <div class="relative pl-3 font-mono sm:pl-4">
        <InfoRow label="Foundation">
          <span class="break-words font-mono text-base font-semibold leading-7 text-slate-900 dark:text-white sm:text-lg">
            Mathematics & Computer Science, University of Ankatso
          </span>
        </InfoRow>
      </div>
      <div class="relative pl-3 font-mono sm:pl-4">
        <InfoRow label="Based in">
          <span class="break-words font-mono text-base font-semibold leading-7 text-slate-900 dark:text-white sm:text-lg">
            Antananarivo, Madagascar (UTC+3)
          </span>
        </InfoRow>
      </div>
      <div class="relative pl-3 font-mono sm:pl-4">
        <InfoRow label="Work mode">
          <span class="break-words font-mono text-base font-semibold leading-7 text-slate-900 dark:text-white sm:text-lg">
            Portfolio and personal projects
          </span>
        </InfoRow>
      </div>
    </dl>
  </section>

  <!-- Tools -->
  <section class="mb-12 sm:mb-16">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h2 class="section-title text-slate-950 dark:text-white">Tools I Use</h2>
    </div>

    <ul class="grid grid-cols-2 gap-x-4 gap-y-4 font-mono sm:flex sm:flex-wrap sm:gap-x-6 sm:gap-y-3">
      {stack.map((item) => (
        <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300 [&_svg]:h-6 [&_svg]:w-6 [&_svg]:shrink-0 sm:[&_svg]:h-5 sm:[&_svg]:w-5">
          <Icon name={item.icon} />
          <span class="text-base font-semibold">{item.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Contact -->
  <section class="mb-8 sm:mb-12">
    <div class="mb-4 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-[#557c64]"></span>
      <h2 class="section-title text-slate-950 dark:text-white">Contact</h2>
    </div>

    <p class="max-w-2xl text-base leading-7 text-slate-700 dark:text-slate-300 sm:text-lg sm:leading-relaxed">
      For professional exchanges or technical discussions, write to{" "}
      <a
        href="mailto:hello@sadiarnel.me"
        class="break-all font-mono font-semibold text-[#24302a] underline decoration-[#b56f4a] underline-offset-4 dark:text-[#edf1e8]"
      >hello@sadiarnel.me</a>{" "}
      or browse my code on{" "}
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono font-semibold text-[#24302a] underline decoration-[#b56f4a] underline-offset-4 dark:text-[#edf1e8]"
      >GitHub</a>.
    </p>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>