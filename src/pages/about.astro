---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import InfoRow from "../components/InfoRow.astro";
---

<Layout title="About — RAHARINANDRASANA Willys Sadi Arnel">
  <Nav />

  <section class="mb-14 sm:mb-20">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 rounded-full bg-orange-500"></span>
      <h1 class="text-lg font-bold tracking-tight text-slate-950 dark:text-white sm:text-xl">
        About Me
      </h1>
    </div>

    <div class="max-w-2xl space-y-4 text-base leading-relaxed text-slate-700 text-pretty dark:text-slate-300 sm:text-lg">
      <div class="relative pl-3 sm:pl-4 font-mono">
        <span class="absolute left-0 top-0 select-none font-mono text-orange-500">›</span>
        <p>
          I'm a junior backend and cloud engineer based in Antananarivo, Madagascar,
          currently expanding my expertise in software engineering at Haute École
          d'Informatique (HEI).
        </p>
      </div>
      <div class="relative pl-3 sm:pl-4 font-mono">
        <span class="absolute left-0 top-0 select-none font-mono text-orange-500">›</span>
        <p>
          My focus centers on infrastructure automation, cloud-native tooling, and
          building reliable backend services using technologies like Go, Terraform,
          Docker, and Rust.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-14 sm:mb-16">
    <div class="mb-6 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 rounded-full bg-orange-500"></span>
      <h2 class="text-lg font-bold tracking-tight text-slate-950 dark:text-white sm:text-xl">
        Background & Education
      </h2>
    </div>

    <dl class="space-y-3 font-mono">
      <div class="relative pl-3 sm:pl-4 font-mono">
        <InfoRow label="Current">
          <span class="font-mono text-base font-semibold text-slate-900 dark:text-white sm:text-lg">
            3rd-year Software Engineering Student at HEI Madagascar
          </span>
        </InfoRow>
      </div>
      <div class="relative pl-3 sm:pl-4 font-mono">
        <InfoRow label="Previous">
          <span class="font-mono text-base font-semibold text-slate-900 dark:text-white sm:text-lg">
            Mathematics & Computer Science at University of Ankatso
          </span>
        </InfoRow>
      </div>
      <div class="relative pl-3 sm:pl-4 font-mono">
        <InfoRow label="Focus">
          <span class="font-mono text-base font-semibold text-slate-900 dark:text-white sm:text-lg">
            Cloud Automation, Infrastructure as Code, CLI/TUI Tools
          </span>
        </InfoRow>
      </div>
    </dl>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>