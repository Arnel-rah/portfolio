---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import InfoRow from "../components/InfoRow.astro";
---

<Layout title="About — RAHARINANDRASANA Willys Sadi Arnel">
  <Nav />

  <section class="mb-16 sm:mb-20">
    <h1 class="text-lg sm:text-xl font-semibold text-stone-900 dark:text-stone-100 mb-6">
      About Me
    </h1>

    <div class="space-y-4 text-stone-700 dark:text-stone-300 text-sm sm:text-base leading-relaxed text-pretty max-w-2xl">
      <p>
        I'm a junior backend and cloud engineer based in Antananarivo, Madagascar,
        currently expanding my expertise in software engineering at Haute École
        d'Informatique (HEI).
      </p>
      <p>
        My focus centers on infrastructure automation, cloud-native tooling, and
        building reliable backend services using technologies like Go, Terraform,
        Docker, and Rust.
      </p>
    </div>
  </section>

  <section class="mb-16 sm:mb-20">
    <h2 class="text-lg sm:text-xl font-semibold text-stone-900 dark:text-stone-100 mb-6">
      Background & Education
    </h2>

    <dl class="space-y-3">
      <InfoRow label="Current">
        <span class="text-stone-900 dark:text-stone-100 font-medium text-sm sm:text-base">
          3rd-year Software Engineering Student at HEI Madagascar
        </span>
      </InfoRow>
      <InfoRow label="Previous">
        <span class="text-stone-900 dark:text-stone-100 font-medium text-sm sm:text-base">
          Mathematics & Computer Science at University of Ankatso
        </span>
      </InfoRow>
      <InfoRow label="Focus">
        <span class="text-stone-900 dark:text-stone-100 font-medium text-sm sm:text-base">
          Cloud Automation, Infrastructure as Code, CLI/TUI Tools
        </span>
      </InfoRow>
    </dl>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>