---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AchievementList from "../components/AchievementList.astro";
import NowSection from "../components/NowSection.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";

const projects = [
  {
    title: "Secure Deploy Kit",
    description:
      "An infrastructure-as-code project provisioning cloud resources locally with Terraform and LocalStack, backed by a Go demo API secured with OIDC token verification.",
    tech: [
      { name: "Terraform", icon: "simple-icons:terraform" },
      { name: "LocalStack", icon: "lucide:layers" },
      { name: "Go", icon: "simple-icons:go" },
    ],
    repo: "https://github.com/Arnel-rah",
    badge: "Featured",
  },
  {
    title: "GhostPort",
    description:
      "A remote port and process monitoring tool streaming real-time status data over gRPC, with a terminal UI.",
    tech: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "gRPC", icon: "lucide:network" },
      { name: "Docker", icon: "simple-icons:docker" },
    ],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Eco-Scale Daemon",
    description:
      "A Go background daemon interacting with the Docker SDK to dynamically scale or stop containers based on energy policies.",
    tech: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "Docker SDK", icon: "simple-icons:docker" },
    ],
    repo: "https://github.com/Arnel-rah",
  },
];

const achievements = [
  { text: "Provision and secure cloud infrastructure as code using Terraform, LocalStack, and AWS." },
  { text: "Automate containerized workloads and cloud deployment pipelines with Docker and GitHub Actions." },
  { text: "Build cloud automation daemons, CLI tools, and backend microservices in Go." },
  { text: "Based in Madagascar, building in public on GitHub.", href: "https://github.com/Arnel-rah" },
];

const cloudStack = [
  {
    category: "Cloud & IaC",
    uiIcon: "lucide:cloud",
    items: [
      { name: "Terraform", icon: "simple-icons:terraform" },
      { name: "AWS", icon: "simple-icons:amazonaws" },
      { name: "LocalStack", icon: "lucide:layers" },
      { name: "DigitalOcean", icon: "simple-icons:digitalocean" },
    ],
  },
  {
    category: "Containers",
    uiIcon: "lucide:container",
    items: [
      { name: "Docker", icon: "simple-icons:docker" },
      { name: "Compose", icon: "simple-icons:docker" },
      { name: "Docker SDK", icon: "simple-icons:docker" },
    ],
  },
  {
    category: "Languages & Ops",
    uiIcon: "lucide:terminal",
    items: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "Python", icon: "simple-icons:python" },
      { name: "GitHub Actions", icon: "simple-icons:githubactions" },
      { name: "Bash / Zsh", icon: "simple-icons:gnubash" },
    ],
  },
];

const contacts = [
  { label: "Email", value: "hello@sadiarnel.me", href: "mailto:hello@sadiarnel.me", icon: "lucide:mail" },
  { label: "GitHub", value: "github.com/Arnel-rah", href: "https://github.com/Arnel-rah", icon: "simple-icons:github" },
  { label: "LinkedIn", value: "linkedin.com/in/arnel-raharinandrasana", href: "https://linkedin.com/in/arnel-raharinandrasana", icon: "simple-icons:linkedin" },
];
---

<Layout title="RAHARINANDRASANA Willys Sadi Arnel — Cloud & Infrastructure Engineer">
  <Nav />

  <Hero
    name="RAHARINANDRASANA Willys Sadi Arnel"
    initials="WA"
    role="Cloud & Infrastructure Engineer"
    intro="I design automated cloud infrastructure, declarative deployment pipelines, and cloud-native tools — specializing in Terraform, Go, Docker, and AWS workflows."
  />

  <AchievementList items={achievements} />

  <NowSection />

  <section id="projects" class="mb-8 sm:mb-12 font-mono">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4 sm:mb-6">
      <div class="flex items-center gap-2.5">
        <span class="inline-block w-2 h-2 rounded-full bg-indigo-500"></span>
        <h2 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100 tracking-tight font-mono">
          Featured Projects
        </h2>
      </div>
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 hover:text-indigo-600 dark:hover:text-indigo-400 underline underline-offset-4 transition-colors font-mono"
      >
        View all on GitHub ↗
      </a>
    </div>

    <div class="flex flex-col">
      {projects.map((p) => <ProjectItem {...p} />)}
    </div>
  </section>

  <section id="stack" class="mb-8 sm:mb-12 font-mono">
    <div class="flex items-center gap-2.5 mb-5 sm:mb-8">
      <span class="inline-block w-2 h-2 rounded-full bg-indigo-500"></span>
      <h2 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100 tracking-tight font-mono">
        Cloud Tech Stack
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-x-10 font-mono">
      {cloudStack.map((group) => (
        <div class="flex flex-col gap-4 font-mono">
          <div class="flex items-center gap-2.5 pb-3 border-b border-stone-200 dark:border-stone-800 font-mono">
            <Icon name={group.uiIcon} class="w-4 h-4 text-stone-400 dark:text-stone-500" />
            <h3 class="text-xs sm:text-sm font-semibold uppercase tracking-[0.12em] text-stone-500 dark:text-stone-400 font-mono">
              {group.category}
            </h3>
          </div>

          <ul class="flex flex-col gap-3 font-mono">
            {group.items.map((item) => (
              <li class="flex items-center gap-3 font-mono">
                <span class="shrink-0 w-10 h-10 flex items-center justify-center text-stone-700 dark:text-stone-200 [&_svg]:w-6 [&_svg]:h-6">
                  <Icon name={item.icon} />
                </span>
                <span class="text-base sm:text-lg font-medium text-stone-700 dark:text-stone-300 font-mono">
                  {item.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="mb-8 sm:mb-12 font-mono">
    <div class="flex items-center gap-2.5 mb-3 sm:mb-4">
      <span class="inline-block w-2 h-2 rounded-full bg-indigo-500"></span>
      <h2 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100 tracking-tight font-mono">
        Get in touch
      </h2>
    </div>

    <ul class="flex items-center gap-4 font-mono">
      {contacts.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={item.label}
            title={item.label}
            class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-indigo-500/10 border border-indigo-500/25 text-indigo-600 dark:text-indigo-400 transition-colors hover:bg-indigo-500/20 hover:text-indigo-700 dark:hover:text-indigo-300 [&_svg]:w-5 [&_svg]:h-5 font-mono"
          >
            <Icon name={item.icon} />
            <span class="sr-only">{item.value}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>