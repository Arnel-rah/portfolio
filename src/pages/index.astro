---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AchievementList from "../components/AchievementList.astro";
import NowSection from "../components/NowSection.astro";
import ProjectItem from "../components/ProjectItem.astro";
import InfoRow from "../components/InfoRow.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    title: "Secure Deploy Kit",
    description: "An infrastructure-as-code project provisioning cloud resources locally with Terraform and LocalStack, backed by a Go demo API secured with OIDC token verification.",
    tech: ["Terraform", "LocalStack", "Go"],
    repo: "https://github.com/Arnel-rah",
    badge: "Featured",
  },
  {
    title: "GhostPort",
    description: "A remote port and process monitoring tool streaming real-time status data over gRPC, with a terminal UI.",
    tech: ["Go", "gRPC", "Docker"],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Eco-Scale Daemon",
    description: "A Go background daemon interacting with the Docker SDK to dynamically scale or stop containers based on energy policies.",
    tech: ["Go", "Docker SDK"],
    repo: "https://github.com/Arnel-rah",
  },
];

const achievements = [
  { text: "Provision and secure cloud infrastructure as code using Terraform, LocalStack, and AWS." },
  { text: "Automate containerized workloads and cloud deployment pipelines with Docker and GitHub Actions." },
  { text: "Build cloud automation daemons, CLI tools, and backend microservices in Go." },
  { text: "Based in Madagascar, building in public on GitHub.", href: "https://github.com/Arnel-rah" },
];

const cloudStack = [
  {
    category: "Cloud & IaC",
    items: ["Terraform", "AWS", "LocalStack", "DigitalOcean"],
  },
  {
    category: "Containers",
    items: ["Docker", "Docker Compose", "Docker SDK"],
  },
  {
    category: "Languages & Ops",
    items: ["Go", "Python", "GitHub Actions", "Bash / Zsh"],
  },
];
---

<Layout title="RAHARINANDRASANA Willys Sadi Arnel — Cloud & Infrastructure Engineer">
  <Nav />

  <Hero
    name="RAHARINANDRASANA Willys Sadi Arnel"
    initials="WA"
    role="Cloud & Infrastructure Engineer"
    intro="I design automated cloud infrastructure, declarative deployment pipelines, and cloud-native tools — specializing in Terraform, Go, Docker, and AWS workflows."
  />

  <AchievementList items={achievements} />

  <NowSection />

  <!-- Section Projets -->
  <section id="projects" class="mb-16 font-mono">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-stone-300 dark:border-stone-700">
      <div class="flex items-center gap-2">
        <span class="text-stone-500 dark:text-stone-400 font-bold select-none text-sm">//</span>
        <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100">
          Featured Projects
        </h2>
      </div>
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 hover:text-stone-900 dark:hover:text-white underline underline-offset-4 transition-colors"
      >
        View all on GitHub ↗
      </a>
    </div>

    <div class="mt-4">
      {projects.map((p) => <ProjectItem {...p} />)}
    </div>
  </section>

  <!-- Section Technical Stack -->
  <section id="stack" class="mb-16 font-mono">
    <div class="flex items-center gap-2 pb-3 border-b border-stone-300 dark:border-stone-700">
      <span class="text-stone-500 dark:text-stone-400 font-bold select-none text-sm">//</span>
      <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100">
        Cloud Tech Stack
      </h2>
    </div>
    <dl class="mt-4 space-y-2">
      {cloudStack.map((group) => (
        <InfoRow label={group.category}>
          <span class="text-stone-900 dark:text-stone-100 text-base font-medium break-words">
            {group.items.join(" · ")}
          </span>
        </InfoRow>
      ))}
    </dl>
  </section>

  <!-- Section Contact -->
  <section id="contact" class="mb-16 font-mono">
    <div class="flex items-center gap-2 pb-3 border-b border-stone-300 dark:border-stone-700">
      <span class="text-stone-500 dark:text-stone-400 font-bold select-none text-sm">//</span>
      <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100">
        Contact & Links
      </h2>
    </div>
    <dl class="mt-4 space-y-2">
      <InfoRow label="Email">
        <a
          href="mailto:hello@sadiarnel.me"
          class="text-stone-900 dark:text-stone-100 text-base font-medium hover:text-black dark:hover:text-white underline underline-offset-4 decoration-stone-400 dark:decoration-stone-500 transition-colors break-all"
        >
          hello@sadiarnel.me
        </a>
      </InfoRow>
      <InfoRow label="GitHub">
        <a
          href="https://github.com/Arnel-rah"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-900 dark:text-stone-100 text-base font-medium hover:text-black dark:hover:text-white underline underline-offset-4 decoration-stone-400 dark:decoration-stone-500 transition-colors break-all"
        >
          github.com/Arnel-rah
        </a>
      </InfoRow>
      <InfoRow label="LinkedIn">
        <a
          href="https://linkedin.com/in/arnel-raharinandrasana"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-900 dark:text-stone-100 text-base font-medium hover:text-black dark:hover:text-white underline underline-offset-4 decoration-stone-400 dark:decoration-stone-500 transition-colors break-all"
        >
          linkedin.com/in/arnel-raharinandrasana
        </a>
      </InfoRow>
    </dl>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>