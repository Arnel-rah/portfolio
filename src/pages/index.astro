---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AchievementList from "../components/AchievementList.astro";
import NowSection from "../components/NowSection.astro";
import ProjectItem from "../components/ProjectItem.astro";
import InfoRow from "../components/InfoRow.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    title: "Secure Deploy Kit",
    description: "An infrastructure-as-code toolkit with built-in pipeline vulnerability scanning and single-command deployment.",
    repo: "https://github.com/Arnel-rah",
    badge: "Featured",
  },
  {
    title: "GhostPort",
    description: "A remote port and process monitoring tool streaming real-time status data over gRPC, with a terminal UI.",
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "TunePipe",
    description: "A terminal application for streaming YouTube audio, built as a fast and dependency-light TUI.",
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Cinema Reservation API",
    description: "A RESTful backend service handling seat booking workflows, transactional concurrency, and schedule management.",
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Air Quality ETL Pipeline",
    description: "An automated data pipeline collecting environmental metrics, cleaning the dataset, and producing analytical reports.",
    tech: ["Python", "ETL"],
    repo: "https://github.com/Arnel-rah",
  },
];

const achievements = [
  { text: "Automate deployments end-to-end, from commit to production, using Terraform and GitHub Actions." },
  { text: "Work across Go, Java (Spring Boot) and Python for backend services and infrastructure tooling." },
  { text: "Build and ship personal projects, from IaC toolkits to gRPC services and terminal apps." },
  { text: "Based in Madagascar, building in public on GitHub.", href: "https://github.com/Arnel-rah" },
];
---

<Layout title="RAHARINANDRASANA Willys Sadi Arnel — Backend & Cloud Automation Engineer">
  <Nav />

  <Hero
    name="RAHARINANDRASANA Willys Sadi Arnel"
    initials="WA"
    role="Backend & Cloud Automation Engineer"
    intro="I design automated infrastructure, secure CI/CD pipelines, and high-performance backend systems — specializing in Go, Java, and Python. Based in Madagascar, working remotely."
  />

  <AchievementList items={achievements} />

  <NowSection />
  <section id="projects" class="mb-12 font-mono">
    <div class="flex items-center justify-between pb-2 border-b border-stone-800/80">
      <div class="flex items-center gap-2">
        <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
        <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
          Featured Projects
        </h2>
      </div>
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-stone-500 hover:text-stone-300 transition-colors"
      >
        View all on GitHub ↗
      </a>
    </div>

    <div class="mt-4">
      {projects.map((p) => <ProjectItem {...p} />)}
    </div>
  </section>

  <section id="stack" class="mb-12 font-mono">
    <div class="flex items-center gap-2 pb-2 border-b border-stone-800/80">
      <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
      <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
        Technical Stack
      </h2>
    </div>
    <dl class="mt-2">
      <InfoRow label="Infrastructure">
        Terraform, Docker, Linux
      </InfoRow>
      <InfoRow label="CI/CD & Security">
        GitHub Actions, Trivy
      </InfoRow>
      <InfoRow label="Languages">
        Go, Java (Spring Boot), Python
      </InfoRow>
      <InfoRow label="Cloud Platforms">
        DigitalOcean, Azure
      </InfoRow>
    </dl>
  </section>

  <section id="contact" class="mb-12 font-mono">
    <div class="flex items-center gap-2 pb-2 border-b border-stone-800/80">
      <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
      <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
        Contact
      </h2>
    </div>
    <dl class="mt-2">
      <InfoRow label="Email">
        <a
          href="mailto:you@example.com"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          sadiarnel145@gmail.com
        </a>
      </InfoRow>
      <InfoRow label="GitHub">
        <a
          href="https://github.com/Arnel-rah"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          github.com/Arnel-rah
        </a>
      </InfoRow>
      <InfoRow label="LinkedIn">
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          linkedin.com/in/arnel-raharinandrasana
        </a>
      </InfoRow>
    </dl>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>