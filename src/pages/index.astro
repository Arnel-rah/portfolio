---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AchievementList from "../components/AchievementList.astro";
import NowSection from "../components/NowSection.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";

const projects = [
  {
    title: "Secure Deploy Kit",
    description:
      "Infrastructure as code that provisions cloud resources locally with Terraform and LocalStack, plus a Go demo API secured with OIDC token verification and a pipeline that scans for vulnerabilities.",
    tech: [
      { name: "Terraform", icon: "simple-icons:terraform" },
      { name: "LocalStack", icon: "lucide:layers" },
      { name: "Go", icon: "simple-icons:go" },
      { name: "GitHub Actions", icon: "simple-icons:githubactions" },
    ],
    repo: "https://github.com/Arnel-rah",
    badge: "Featured",
  },
  {
    title: "GhostPort",
    description:
      "A remote port and process monitor that streams real-time status over gRPC to a terminal UI, packaged to run in Docker.",
    tech: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "gRPC", icon: "lucide:network" },
      { name: "Docker", icon: "simple-icons:docker" },
    ],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Eco-Scale Daemon",
    description:
      "A Go daemon built on the Docker SDK that scales or stops containers automatically based on energy policies.",
    tech: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "Docker SDK", icon: "simple-icons:docker" },
    ],
    repo: "https://github.com/Arnel-rah",
  },
];

const achievements = [
  { text: "Provision and secure cloud infrastructure as code with Terraform, LocalStack, and AWS." },
  { text: "Automate build, test, and deployment pipelines for containerized workloads with Docker and GitHub Actions." },
  { text: "Build cloud automation daemons, CLI tools, and backend services in Go." },
  { text: "Working remotely from Madagascar (UTC+3), building in public on GitHub.", href: "https://github.com/Arnel-rah" },
];

const cloudStack = [
  {
    category: "Cloud & IaC",
    uiIcon: "lucide:cloud",
    items: [
      { name: "Terraform", icon: "simple-icons:terraform" },
      { name: "AWS", icon: "simple-icons:amazonaws" },
      { name: "LocalStack", icon: "lucide:layers" },
      { name: "DigitalOcean", icon: "simple-icons:digitalocean" },
    ],
  },
  {
    category: "Containers & CI/CD",
    uiIcon: "lucide:container",
    items: [
      { name: "Docker", icon: "simple-icons:docker" },
      { name: "Compose", icon: "simple-icons:docker" },
      { name: "Docker SDK", icon: "simple-icons:docker" },
      { name: "GitHub Actions", icon: "simple-icons:githubactions" },
    ],
  },
  {
    category: "Languages & Scripting",
    uiIcon: "lucide:terminal",
    items: [
      { name: "Go", icon: "simple-icons:go" },
      { name: "Python", icon: "simple-icons:python" },
      { name: "Bash / Zsh", icon: "simple-icons:gnubash" },
    ],
  },
];

const contacts = [
  { label: "Email", value: "hello@sadiarnel.me", href: "mailto:hello@sadiarnel.me", icon: "lucide:mail" },
  { label: "GitHub", value: "github.com/Arnel-rah", href: "https://github.com/Arnel-rah", icon: "simple-icons:github" },
  { label: "LinkedIn", value: "linkedin.com/in/arnel-raharinandrasana", href: "https://linkedin.com/in/arnel-raharinandrasana", icon: "simple-icons:linkedin" },
];
---

<Layout title="RAHARINANDRASANA Willys Sadi Arnel — DevOps & Cloud Engineer">
  <Nav />

  <Hero
    name="RAHARINANDRASANA Willys Sadi Arnel"
    initials="WA"
    role="DevOps & Cloud Engineer"
    intro="I help teams automate cloud infrastructure and delivery pipelines with Terraform, Docker, GitHub Actions, AWS, and Go. Based in Madagascar, available for remote freelance work."
  />

  <AchievementList items={achievements} />

  <NowSection />

  <section id="projects" class="mb-12 sm:mb-20">
    <div class="mb-5 flex flex-col items-start gap-3 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex items-center gap-2.5">
        <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-orange-500"></span>
        <h2 class="section-title text-slate-950 dark:text-white">
          Featured Projects
        </h2>
      </div>
      <div class="hidden sm:block">
        <a
          href="https://github.com/Arnel-rah"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-slate-500 underline decoration-orange-400 underline-offset-4 dark:text-slate-400"
        >
          View all on GitHub ↗
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-4 sm:gap-5">
      {projects.map((p) => <ProjectItem {...p} />)}
    </div>

    <div class="mt-5 sm:hidden">
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-sm text-slate-500 underline decoration-orange-400 underline-offset-4 dark:text-slate-400"
      >
        View all on GitHub ↗
      </a>
    </div>
  </section>

  <section id="stack" class="mb-12 sm:mb-20">
    <div class="mb-5 flex items-center gap-2.5 sm:mb-8">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-orange-500"></span>
      <h2 class="section-title text-slate-950 dark:text-white">
        Cloud Tech Stack
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6">
      {cloudStack.map((group) => (
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2.5 border-b border-slate-300 pb-3 dark:border-slate-700">
            <Icon name={group.uiIcon} class="h-4 w-4 shrink-0 text-slate-500 dark:text-slate-400" />
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-700 dark:text-slate-200">
              {group.category}
            </h3>
          </div>

          <ul class="flex flex-col gap-3 font-mono">
            {group.items.map((item) => (
              <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300 [&_svg]:h-5 [&_svg]:w-5 [&_svg]:shrink-0">
                <Icon name={item.icon} />
                <span class="text-base font-semibold">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="mb-0 sm:mb-12">
    <div class="mb-4 flex items-center gap-2.5">
      <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-orange-500"></span>
      <h2 class="section-title text-slate-950 dark:text-white">
        Get in touch
      </h2>
    </div>

    <p class="mb-5 max-w-2xl text-base leading-7 text-slate-700 dark:text-slate-300 sm:text-lg sm:leading-relaxed">
      Need help with cloud infrastructure, CI/CD, or automation? I'm open to remote freelance
      projects. Write to me at{" "}
      <a
        href="mailto:hello@sadiarnel.me"
        class="break-all font-mono font-semibold text-slate-950 underline decoration-orange-400 underline-offset-4 dark:text-white"
      >hello@sadiarnel.me</a>.
    </p>

    <ul class="flex items-center gap-4 font-mono">
      {contacts.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
            aria-label={item.label}
            title={item.label}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 [&_svg]:h-5 [&_svg]:w-5"
          >
            <Icon name={item.icon} />
            <span class="sr-only">{item.value}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>