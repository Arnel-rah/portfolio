---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AchievementList from "../components/AchievementList.astro";
import NowSection from "../components/NowSection.astro";
import ProjectItem from "../components/ProjectItem.astro";
import InfoRow from "../components/InfoRow.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    title: "Secure Deploy Kit",
    description: "An infrastructure-as-code project provisioning cloud resources locally with Terraform and LocalStack, backed by a Go demo API secured with OIDC token verification.",
    tech: ["Terraform", "LocalStack", "Go"],
    repo: "https://github.com/Arnel-rah",
    badge: "Featured",
  },
  {
    title: "GhostPort",
    description: "A remote port and process monitoring tool streaming real-time status data over gRPC, with a terminal UI.",
    tech: ["Go", "gRPC", "Docker"],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "TunePipe",
    description: "A terminal application for streaming YouTube audio, built as a fast and dependency-light TUI.",
    tech: ["Go", "TUI"],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Cinema Reservation API",
    description: "A RESTful backend service built with the Poja framework, handling seat booking workflows, transactional concurrency, and schedule management.",
    tech: ["Java", "Spring Boot", "Poja"],
    repo: "https://github.com/Arnel-rah",
  },
  {
    title: "Air Quality ETL Pipeline",
    description: "An automated data pipeline collecting environmental metrics, cleaning the dataset, and producing analytical reports.",
    tech: ["Python", "ETL"],
    repo: "https://github.com/Arnel-rah",
  },
];

const achievements = [
  { text: "Provision and secure cloud infrastructure as code, using Terraform and LocalStack." },
  { text: "Work across Go and Java (Spring Boot, Poja) for backend services and infrastructure tooling." },
  { text: "Build and ship personal projects end-to-end, from IaC toolkits to gRPC services and terminal apps." },
  { text: "Based in Madagascar, building in public on GitHub.", href: "https://github.com/Arnel-rah" },
];
---

<Layout title="RAHARINANDRASANA Willys Sadi Arnel — DevOps & Cloud Engineer">
  <Nav />

  <Hero
    name="RAHARINANDRASANA Willys Sadi Arnel"
    initials="WA"
    role="DevOps & Cloud Engineer"
    intro="I design automated infrastructure, secure deployments, and backend services — specializing in Go and Java, with a focus on Terraform and cloud tooling. Based in Madagascar, working remotely."
  />

  <AchievementList items={achievements} />

  <NowSection />
  <section id="projects" class="mb-12 font-mono">
    <div class="flex items-center justify-between pb-2 border-b border-stone-800/80">
      <div class="flex items-center gap-2">
        <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
        <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
          Featured Projects
        </h2>
      </div>
      <a
        href="https://github.com/Arnel-rah"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-mono text-stone-500 hover:text-stone-300 transition-colors"
      >
        View all on GitHub ↗
      </a>
    </div>

    <div class="mt-4">
      {projects.map((p) => <ProjectItem {...p} />)}
    </div>
  </section>

  <section id="stack" class="mb-12 font-mono">
    <div class="flex items-center gap-2 pb-2 border-b border-stone-800/80">
      <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
      <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
        Technical Stack
      </h2>
    </div>
    <dl class="mt-2">
      <InfoRow label="Infrastructure">
        Terraform, LocalStack, Docker, Linux
      </InfoRow>
      <InfoRow label="CI/CD & Security">
        GitHub Actions, OIDC
      </InfoRow>
      <InfoRow label="Languages">
        Go, Java (Spring Boot, Poja), Python
      </InfoRow>
      <InfoRow label="Cloud Platforms">
        DigitalOcean, Azure
      </InfoRow>
    </dl>
  </section>

  <section id="contact" class="mb-12 font-mono">
    <div class="flex items-center gap-2 pb-2 border-b border-stone-800/80">
      <span class="text-stone-600 select-none text-sm sm:text-base font-medium">//</span>
      <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-200">
        Contact
      </h2>
    </div>
    <dl class="mt-2">
      <InfoRow label="Email">
        <a
          href="mailto:you@example.com"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          you@example.com
        </a>
      </InfoRow>
      <InfoRow label="GitHub">
        <a
          href="https://github.com/Arnel-rah"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          github.com/Arnel-rah
        </a>
      </InfoRow>
      <InfoRow label="LinkedIn">
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
        >
          linkedin.com/in/your-profile
        </a>
      </InfoRow>
    </dl>
  </section>

  <Footer name="RAHARINANDRASANA Willys Sadi Arnel" sourceUrl="https://github.com/Arnel-rah" />
</Layout>