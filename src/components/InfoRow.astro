---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="row">
  <dt>{label}</dt>
  <dd><slot /></dd>
</div>

<style>
.row{display:grid;grid-template-columns:10rem 1fr;gap:.3rem 1.5rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.row dt{font-weight:600}
.row dd{margin:0;color:var(--muted)}
@media (max-width:36rem){.row{grid-template-columns:1fr}}
</style>