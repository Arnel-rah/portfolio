---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-[10.5rem_1fr] gap-1 sm:gap-4 py-2.5 border-b border-stone-300/60 dark:border-stone-800/60 last:border-b-0 text-sm font-mono text-left transition-colors duration-200">
  <dt class="font-semibold text-stone-500 dark:text-stone-500 text-xs uppercase tracking-wider self-start pt-0.5 transition-colors duration-200">
    {label}
  </dt>
  <dd class="text-stone-700 dark:text-stone-300 m-0 text-left transition-colors duration-200">
    <slot />
  </dd>
</div>