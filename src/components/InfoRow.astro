---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="grid grid-cols-1 sm:grid-cols-[10.5rem_1fr] gap-1 sm:gap-4 py-3 border-b border-stone-200 dark:border-stone-800/80 text-sm">
  <dt class="font-medium text-stone-900 dark:text-stone-100 font-mono text-xs uppercase tracking-wider self-center">
    {label}
  </dt>
  <dd class="text-stone-600 dark:text-stone-400 m-0">
    <slot />
  </dd>
</div>