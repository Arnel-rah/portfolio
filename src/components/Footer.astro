---
interface Props {
  name: string;
  sourceUrl?: string;
}
const { name, sourceUrl = "#" } = Astro.props;
---
<footer class="mt-16 pt-6 border-t border-stone-200 dark:border-stone-800/80 flex items-center justify-between text-xs text-stone-500 dark:text-stone-400 font-mono">
  <span>© {new Date().getFullYear()} {name}</span>

</footer>