---
interface Props {
  name: string;
  sourceUrl?: string;
}
const { name, sourceUrl = "#" } = Astro.props;
---

<footer class="mt-8 flex items-center justify-between border-t border-[#aeb9ae] pt-6 text-sm text-[#667268] transition-colors duration-200 dark:border-[#405348] dark:text-[#aab5ad] font-mono sm:mt-20">
  <span class="font-medium">© {new Date().getFullYear()} {name}</span>
</footer>