---
interface Item {
  text: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section id="about" class="mb-12 font-mono">
  <!-- Titre de section style console / terminal -->
  <h2 class="text-xs uppercase tracking-widest text-stone-500 font-semibold pb-2 border-b border-stone-800/80">
    Things I've done
  </h2>

  <!-- Liste d'éléments en typographie monospace -->
  <ul class="mt-4 space-y-2.5 text-sm text-stone-400">
    {items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span class="text-stone-500 font-mono shrink-0 select-none">-</span>
        <span>
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-300 hover:text-white underline underline-offset-4 decoration-stone-700 hover:decoration-stone-400 transition-colors"
            >
              {item.text}
            </a>
          ) : (
            item.text
          )}
        </span>
      </li>
    ))}
  </ul>
</section>