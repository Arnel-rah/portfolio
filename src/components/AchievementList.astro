---
interface Item {
  text: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section id="about" class="mb-12 font-mono">
  <div class="flex items-center gap-2 pb-2 border-b border-stone-300/80 dark:border-stone-800/80 transition-colors duration-200">
    <span class="text-stone-400 dark:text-stone-500 select-none text-sm sm:text-base font-medium">//</span>
    <h2 class="text-sm sm:text-base font-semibold uppercase tracking-wider text-stone-900 dark:text-stone-200 transition-colors duration-200">
      Things I've done
    </h2>
  </div>

  <ul class="mt-4 space-y-2.5 text-sm text-stone-600 dark:text-stone-400 transition-colors duration-200">
    {items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span class="text-stone-400 dark:text-stone-500 font-mono shrink-0 select-none">-</span>
        <span>
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-800 dark:text-stone-300 hover:text-teal-600 dark:hover:text-white underline underline-offset-4 decoration-stone-400 dark:decoration-stone-700 hover:decoration-teal-600 dark:hover:decoration-stone-400 transition-colors duration-200"
            >
              {item.text}
            </a>
          ) : (
            item.text
          )}
        </span>
      </li>
    ))}
  </ul>
</section>