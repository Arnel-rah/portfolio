---
interface Item {
  text: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<section id="about" class="mb-16">
  <div class="flex items-center gap-2 pb-3 border-b border-stone-300 dark:border-stone-700 transition-colors duration-200">
    <span class="text-stone-500 dark:text-stone-400 select-none text-sm font-bold">//</span>
    <h2 class="text-base sm:text-lg font-bold uppercase tracking-wider text-stone-900 dark:text-stone-100 transition-colors duration-200">
      Things I've done
    </h2>
  </div>

  <ul class="mt-4 space-y-3 text-base text-stone-800 dark:text-stone-200 transition-colors duration-200">
    {items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span class="text-stone-400 dark:text-stone-500 font-mono shrink-0 select-none">-</span>
        <span>
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-900 dark:text-stone-100 hover:text-black dark:hover:text-white underline underline-offset-4 decoration-stone-400 dark:decoration-stone-600 transition-colors duration-200"
            >
              {item.text}
            </a>
          ) : (
            item.text
          )}
        </span>
      </li>
    ))}
  </ul>
</section>