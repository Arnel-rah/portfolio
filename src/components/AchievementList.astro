---
interface Item {
  text: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<section id="about" class="mb-12">
  <h2 class="text-base font-bold text-stone-900 dark:text-stone-100 pb-2 border-b border-stone-200 dark:border-stone-800">
    Things I've done
  </h2>
  <ul class="mt-3 space-y-2 text-sm text-stone-600 dark:text-stone-400">
    {items.map((item) => (
      <li class="flex items-start gap-2">
        <span class="text-teal-600 dark:text-teal-400 font-mono shrink-0">-</span>
        <span>
          {item.href ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="text-stone-900 dark:text-stone-100 hover:text-teal-600 dark:hover:text-teal-400 underline underline-offset-4 decoration-stone-300 dark:decoration-stone-700 transition-colors">
              {item.text}
            </a>
          ) : (
            item.text
          )}
        </span>
      </li>
    ))}
  </ul>
</section>