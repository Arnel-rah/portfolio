---
import { Sun, Moon } from "@lucide/astro";
---

<header class="mb-12 font-mono">
  <nav class="flex items-center justify-between pb-3 border-b border-stone-300/80 dark:border-stone-800/80 transition-colors">
    <a
      href="/"
      class="text-xs sm:text-sm tracking-widest uppercase transition-colors group"
    >
      <span class="font-bold text-stone-800 dark:text-stone-200 group-hover:text-black dark:group-hover:text-white transition-colors">
        arnel
      </span>
    </a>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle theme"
      class="p-1.5 rounded-md cursor-pointer bg-stone-100 dark:bg-stone-900/90 border border-stone-300 dark:border-stone-800 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 hover:border-stone-400 dark:hover:border-stone-700 focus:outline-none focus-visible:ring-1 focus-visible:ring-stone-400 transition-all"
    >
      <Sun size={15} class="block dark:hidden" />
      <Moon size={15} class="hidden dark:block" />
    </button>
  </nav>
</header>

<script>
  const setupThemeToggle = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    btn.onclick = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
  };

  // Chargement initial + support des transitions de page Astro (ViewTransitions)
  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>