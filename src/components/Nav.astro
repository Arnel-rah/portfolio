---
import { Sun, Moon } from "@lucide/astro";

const isAboutPage = Astro.url.pathname === "/about";
---

<header class="sticky top-0 z-10 -mx-4 mb-12 bg-[#f4f1e7] px-4 pt-3 sm:-mx-8 sm:mb-20 sm:px-8 sm:pt-6 dark:bg-[#17211c]">
  <nav class="flex items-center justify-between gap-6 border-b border-[#aeb9ae] pb-4 dark:border-[#405348]">
    <div class="flex min-w-0 items-center gap-3">
      <a
        href="/"
        aria-label="Arnel home"
        class="group shrink-0 font-mono tracking-[0.18em] uppercase transition-colors"
      >
        <span class="nav-name text-[#24302a] transition-colors group-hover:text-[#557c64] dark:text-[#edf1e8] dark:group-hover:text-[#9bb5a1]">arnel</span>
      </a>
      <span aria-hidden="true" class="font-mono text-[#b56f4a]">/</span>
      <span class="hidden font-mono text-xs uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 sm:inline">sysops engineer</span>
    </div>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 sm:gap-5">
        <a href="/#projects" class="hidden transition-colors hover:text-[#557c64] dark:hover:text-[#9bb5a1] sm:inline">work</a>
        <a
          href="/about"
          aria-current={isAboutPage ? "page" : undefined}
          class:list={[{ "text-[#557c64] dark:text-[#9bb5a1]": isAboutPage }]}
          class="transition-colors hover:text-[#557c64] dark:hover:text-[#9bb5a1]"
        >
          about
        </a>
      </div>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-[#aeb9ae] bg-[#faf8f1] text-[#46554c] transition-colors hover:border-[#557c64] hover:text-[#557c64] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#557c64] focus-visible:ring-offset-2 focus-visible:ring-offset-[#f4f1e7] dark:border-[#405348] dark:bg-[#202f27] dark:text-[#edf1e8] dark:hover:border-[#91aa96] dark:hover:text-[#91aa96] dark:focus-visible:ring-offset-[#17211c]"
      >
        <Sun size={16} class="block dark:hidden" />
        <Moon size={16} class="hidden dark:block" />
      </button>
    </div>
  </nav>
</header>

<script>
  const setupThemeToggle = () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;

    btn.onclick = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
  };

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>