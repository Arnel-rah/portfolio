---
interface Props {
  title: string;
  description: string;
  repo: string;
  badge?: string;
}
const { title, description, repo, badge } = Astro.props;
---

<article class="group py-4 border-b border-stone-300/60 dark:border-stone-800/60 last:border-b-0 font-mono transition-colors duration-200">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-4">
    <div class="flex items-center gap-2">
      <h3 class="text-sm sm:text-base font-semibold">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-800 dark:text-stone-200 group-hover:text-black dark:group-hover:text-white transition-colors duration-200"
        >
          <span class="text-stone-400 dark:text-stone-600 group-hover:text-stone-600 dark:group-hover:text-stone-400 select-none transition-colors duration-200">›</span>
          <span>{title}</span>
          <span class="text-xs text-stone-400 dark:text-stone-500 group-hover:text-stone-600 dark:group-hover:text-stone-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200">
            ↗
          </span>
        </a>
      </h3>
      {badge && (
        <span class="text-[10px] uppercase px-1.5 py-0.5 rounded bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-400 border border-stone-300 dark:border-stone-700/60 transition-colors duration-200">
          {badge}
        </span>
      )}
    </div>
  </div>

  <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-2.5 leading-relaxed text-pretty pl-4 border-l border-stone-300 dark:border-stone-800/60 group-hover:border-stone-400 dark:group-hover:border-stone-700/60 transition-colors duration-200">
    {description}
  </p>
</article>