---
interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  badge?: string;
}
const { title, description, tech, repo, badge } = Astro.props;
---

<article class="group py-4 border-b border-stone-800/80 last:border-b-0 font-mono">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4">
    <div class="flex items-center gap-2">
      <h3 class="text-sm sm:text-base font-semibold">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-200 hover:text-white transition-colors"
        >
          <span>{title}</span>
          <span class="text-xs text-stone-500 group-hover:text-stone-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
            ↗
          </span>
        </a>
      </h3>
      {badge && (
        <span class="text-[10px] uppercase px-1.5 py-0.5 rounded bg-stone-800/80 text-stone-400 border border-stone-700/60">
          {badge}
        </span>
      )}
    </div>

    <div class="flex items-center gap-1.5 text-xs text-stone-500 shrink-0 mt-1 sm:mt-0">
      {tech.join(" · ")}
    </div>
  </div>

  <p class="text-xs sm:text-sm text-stone-400 mt-2 leading-relaxed text-pretty">
    {description}
  </p>
</article>