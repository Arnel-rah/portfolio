---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  tech: { name: string; icon: string }[];
  repo: string;
  badge?: string;
}

const { title, description, tech, repo, badge } = Astro.props;
---

<a
  href={repo}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block py-3.5 sm:py-4 pl-3 sm:pl-4 border-b border-stone-200/80 dark:border-stone-800/80 last:border-b-0 transition-all font-mono"
>
  <!-- Petit indicateur de type puce / flèche rappelant la section Now -->
  <span class="absolute left-0 top-5 text-indigo-600 dark:text-indigo-400 font-mono select-none">›</span>

  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5 flex-wrap min-w-0 font-mono">
      <h3 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors font-mono">
        {title}
      </h3>

      {badge && (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/25 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {badge}
        </span>
      )}
    </div>

    <span class="shrink-0 mt-1 mr-1 text-stone-300 dark:text-stone-700 group-hover:text-indigo-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </span>
  </div>

  <p class="mt-2 text-base sm:text-lg text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl font-mono">
    {description}
  </p>

  <ul class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2.5 font-mono">
    {tech.map((item) => (
      <li class="flex items-center gap-2.5">
        <span class="shrink-0 w-7 h-7 flex items-center justify-center text-stone-700 dark:text-stone-200 [&_svg]:w-5 [&_svg]:h-5">
          <Icon name={item.icon} />
        </span>
        <span class="text-base sm:text-lg font-medium text-stone-700 dark:text-stone-300 font-mono">
          {item.name}
        </span>
      </li>
    ))}
  </ul>

</a>