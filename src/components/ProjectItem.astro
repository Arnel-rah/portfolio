---
interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  badge?: string;
}
const { title, description, tech, repo, badge } = Astro.props;
---

<article class="group py-5 border-b border-stone-300/80 dark:border-stone-800 last:border-b-0 font-mono transition-colors duration-200">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 sm:gap-4">
    <div class="flex items-center gap-2">
      <h3 class="text-base sm:text-lg font-bold">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-black dark:hover:text-white transition-colors duration-200"
        >
          <span class="text-stone-400 dark:text-stone-500 select-none transition-colors duration-200">›</span>
          <span>{title}</span>
          <span class="text-xs text-stone-500 dark:text-stone-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200">
            ↗
          </span>
        </a>
      </h3>
      {badge && (
        <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-stone-200 dark:bg-stone-800 text-stone-800 dark:text-stone-200 border border-stone-300 dark:border-stone-700 transition-colors duration-200">
          {badge}
        </span>
      )}
    </div>

    <span class="font-mono text-xs sm:text-sm text-stone-600 dark:text-stone-400 font-medium shrink-0">
      {tech.join(" · ")}
    </span>
  </div>

  <p class="text-sm sm:text-base text-stone-800 dark:text-stone-200 mt-3 leading-relaxed text-pretty pl-4 border-l-2 border-stone-300 dark:border-stone-700 transition-colors duration-200">
    {description}
  </p>
</article>