---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  tech: { name: string; icon: string }[];
  repo: string;
  badge?: string;
  index?: number;
}

const { title, description, tech, repo, badge, index } = Astro.props;
---

<a
  href={repo}
  target="_blank"
  rel="noopener noreferrer"
  class="group block border-l-[3px] border-[#b56f4a] bg-[#faf8f1] px-4 py-5 transition-colors hover:border-[#557c64] hover:bg-[#fdfcf7] dark:border-[#c17a55] dark:bg-[#1d2922] dark:hover:border-[#91aa96] dark:hover:bg-[#202f27] sm:-mx-3 sm:px-6 sm:py-6"
>
  <div class="flex items-start gap-2 sm:gap-3">
    <span class="shrink-0 min-w-5 select-none font-mono text-xs leading-6 text-[#557c64] sm:text-sm">
      {index ? String(index).padStart(2, "0") : "↗"}
    </span>

    <div class="min-w-0 flex-1 font-mono">
      <div class="flex items-start justify-between gap-3">
        <div class="flex min-w-0 flex-wrap items-center gap-2.5 font-mono">
          <h3 class="text-base font-semibold text-slate-950 dark:text-white sm:text-lg">
            {title}
          </h3>

          {badge && (
            <span class="inline-flex items-center gap-1.5 border border-[#aeb9ae] bg-[#edf0e6] px-2.5 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-[#557c64] dark:border-[#405348] dark:bg-[#26352d] dark:text-[#a8baa9]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#b56f4a]"></span>
              {badge}
            </span>
          )}
        </div>

        <span class="mt-0.5 shrink-0 text-stone-300 dark:text-stone-700">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </span>
      </div>

      <p class="mt-2 max-w-2xl text-sm leading-snug text-slate-600 dark:text-slate-400 sm:text-base sm:leading-relaxed">
        {description}
      </p>

      <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono sm:gap-x-6 sm:gap-y-2.5">
        {tech.map((item) => (
          <li class="flex items-center gap-2.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center text-stone-700 dark:text-stone-200 [&_svg]:h-5 [&_svg]:w-5">
              <Icon name={item.icon} />
            </span>
            <span class="font-mono text-sm font-medium text-stone-700 dark:text-stone-300 sm:text-lg">
              {item.name}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</a>