---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  tech: { name: string; icon: string }[];
  repo: string;
  badge?: string;
}

const { title, description, tech, repo, badge } = Astro.props;
---

<a
  href={repo}
  target="_blank"
  rel="noopener noreferrer"
  class="group -mx-3 block rounded-2xl border border-slate-200 bg-white px-4 py-5 transition-all hover:-translate-y-1 hover:border-orange-300 hover:shadow-[6px_6px_0_#fed7aa] dark:border-slate-700 dark:bg-slate-900 dark:hover:border-orange-500 dark:hover:shadow-[6px_6px_0_#9a3412] sm:px-6 sm:py-6"
>
  <div class="flex items-start gap-2.5 sm:gap-3">
    <span class="shrink-0 select-none font-mono leading-tight text-orange-500 sm:leading-normal">↗</span>

    <div class="min-w-0 flex-1 font-mono">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-2.5 flex-wrap min-w-0 font-mono">
          <h3 class="text-base font-semibold text-slate-950 transition-colors group-hover:text-orange-600 dark:text-white dark:group-hover:text-orange-400 sm:text-lg">
            {title}
          </h3>

          {badge && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/25 font-mono">
              <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
              {badge}
            </span>
          )}
        </div>

        <span class="shrink-0 mt-0.5 text-stone-300 dark:text-stone-700 group-hover:text-indigo-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </span>
      </div>

      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400 sm:text-base">
        {description}
      </p>

      <ul class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2.5 font-mono">
        {tech.map((item) => (
          <li class="flex items-center gap-2.5">
            <span class="shrink-0 w-7 h-7 flex items-center justify-center text-stone-700 dark:text-stone-200 [&_svg]:w-5 [&_svg]:h-5">
              <Icon name={item.icon} />
            </span>
            <span class="text-base sm:text-lg font-medium text-stone-700 dark:text-stone-300 font-mono">
              {item.name}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</a>