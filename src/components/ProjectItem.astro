---
interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  badge?: string;
}

const { title, description, tech, repo, badge } = Astro.props;
---

<article class="group py-3 first:pt-0">
  <div class="flex flex-col gap-1">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-base font-semibold sm:text-lg">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-900 dark:text-stone-100 hover:underline underline-offset-4 decoration-stone-400 dark:decoration-stone-500 transition-colors"
        >
          {title}
        </a>
      </h3>

      {badge && (
        <span class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-300">
          {badge}
        </span>
      )}
    </div>

    <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 font-mono">
      {tech.join(" · ")}
    </p>

    <p class="text-base text-stone-700 dark:text-stone-300 leading-relaxed max-w-2xl">
      {description}
    </p>
  </div>
</article>