---
interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  badge?: string;
}
const { title, description, tech, repo, badge } = Astro.props;
---
<article class="group py-4 border-b border-stone-200 dark:border-stone-800/80">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4">
    <div class="flex items-center gap-2">
      <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">
        <a 
          href={repo} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
        >
          <span>{title}</span>
          <span class="text-xs text-stone-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-transform font-mono">
            ↗
          </span>
        </a>
      </h3>
      {badge && (
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-teal-500/10 text-teal-700 dark:text-teal-300 border border-teal-500/20">
          {badge}
        </span>
      )}
    </div>

    <div class="flex items-center gap-1.5 font-mono text-xs text-stone-500 dark:text-stone-400 shrink-0 mt-1 sm:mt-0">
      {tech.join(" · ")}
    </div>
  </div>

  <p class="text-sm text-stone-600 dark:text-stone-400 mt-2 leading-relaxed text-pretty">
    {description}
  </p>
</article>