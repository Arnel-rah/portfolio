---
interface Props {
  title: string;
  description: string;
  tech: string[];
  repo: string;
  isFeatured?: boolean;
}
const { title, description, tech, repo, isFeatured = false } = Astro.props;
---
<article class="group relative p-5 rounded-xl border border-stone-200 dark:border-stone-800/80 bg-white/50 dark:bg-stone-900/30 hover:border-teal-500/40 dark:hover:border-teal-400/40 hover:shadow-sm transition-all duration-200">
  <div class="flex items-start justify-between gap-4 mb-2">
    <div class="flex items-center gap-2.5">
      <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
        <a href={repo} target="_blank" rel="noopener noreferrer" class="focus:outline-none">
          <span class="absolute inset-0"></span>
          {title}
        </a>
      </h3>
      {isFeatured && (
        <span class="text-[10px] font-semibold tracking-wide uppercase px-2 py-0.5 rounded-full bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-500/20">
          Featured
        </span>
      )}
    </div>
    
    <span class="text-stone-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-transform">
      ↗
    </span>
  </div>

  <p class="text-sm text-stone-600 dark:text-stone-400 mb-4 leading-relaxed">
    {description}
  </p>

  <div class="flex flex-wrap gap-1.5">
    {tech.map((item) => (
      <span class="font-mono text-xs px-2.5 py-0.5 rounded-md bg-stone-100 dark:bg-stone-800/80 text-stone-600 dark:text-stone-300 border border-stone-200/60 dark:border-stone-700/50">
        {item}
      </span>
    ))}
  </div>
</article>