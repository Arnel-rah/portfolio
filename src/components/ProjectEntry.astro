---
interface Props {
  title: string;
  description: string;
  tech: string;
  repo: string;
}
const { title, description, tech, repo } = Astro.props;
---
<article class="group py-4 border-b border-stone-200 dark:border-stone-800/80">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 sm:gap-4">
    <h3 class="text-base font-semibold text-stone-900 dark:text-stone-100">
      <a 
        href={repo} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
      >
        <span>{title}</span>
        <span class="text-xs text-stone-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-transform">
          ↗
        </span>
      </a>
    </h3>
    <span class="font-mono text-xs text-stone-500 dark:text-stone-400 shrink-0">
      {tech}
    </span>
  </div>
  <p class="text-sm text-stone-600 dark:text-stone-400 mt-1.5 leading-relaxed text-pretty">
    {description}
  </p>
</article>