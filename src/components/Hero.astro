---
import { Mail } from "@lucide/astro";

interface Props {
  name: string;
  initials: string;
  role: string;
  intro: string;
}
const { name, initials, role, intro } = Astro.props;
---

<section class="mb-12 font-mono">
  <div class="flex items-center gap-5">
    <div class="shrink-0 w-20 h-20 rounded-full bg-linear-to-tr from-sky-400 via-cyan-400 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/10 border border-cyan-300/30">
      <span class="font-mono text-xl font-bold text-stone-950 tracking-wider">
        {initials}
      </span>
    </div>

    <div>
      <h1 class="text-2xl sm:text-3xl font-mono tracking-wider text-stone-900 dark:text-stone-100 font-medium transition-colors duration-200">
        {name}
      </h1>
      <p class="text-sm sm:text-base font-mono text-stone-600 dark:text-stone-400 mt-1 font-normal transition-colors duration-200">
        {role}
      </p>
    </div>
  </div>

  <p class="font-mono italic text-stone-600 dark:text-stone-400 text-sm sm:text-base leading-relaxed mt-6 max-w-2xl text-pretty transition-colors duration-200">
    {intro}
  </p>

  <div class="mt-5 flex items-center gap-5">
    <a
      href="https://github.com/Arnel-rah"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors duration-200"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
      </svg>
    </a>

    <a
      href="https://linkedin.com/in/arnel-raharinandrasana"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors duration-200"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
      </svg>
    </a>

    <a
      href="mailto:sadiarnel145@gmail.com"
      aria-label="Email"
      class="text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors duration-200"
    >
      <Mail size={26} stroke-width={1.6} />
    </a>
  </div>
</section>