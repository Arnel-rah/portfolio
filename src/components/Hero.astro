---
interface Props {
  name: string;
  role: string;
  intro: string;
}
const { name, role, intro } = Astro.props;
---
<section class="mb-10">
  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-tight">
    {name}
  </h1>
  <p class="text-sm font-mono text-teal-600 dark:text-teal-400 mt-1.5">
    {role}
  </p>
  <p class="text-stone-600 dark:text-stone-400 text-base leading-relaxed mt-4 text-pretty">
    {intro}
  </p>

  <div class="mt-5 flex items-center gap-4 text-sm font-medium">
    <a 
      href="mailto:you@example.com" 
      class="inline-flex items-center gap-1.5 text-stone-900 dark:text-stone-100 hover:text-teal-600 dark:hover:text-teal-400 underline underline-offset-4 decoration-stone-300 dark:decoration-stone-700 transition-colors"
    >
      <span>Get in touch</span>
      <span class="text-xs">→</span>
    </a>
    <a 
      href="https://github.com/Arnel-rah" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-1.5 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
    >
      <span>GitHub</span>
      <span class="text-xs font-mono">↗</span>
    </a>
  </div>
</section>