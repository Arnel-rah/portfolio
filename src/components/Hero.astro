---
import { Mail } from "@lucide/astro";

interface Props {
  name: string;
  initials: string;
  role: string;
  intro: string;
}
const { name, initials, role, intro } = Astro.props;

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/Arnel-rah",
    path: "M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/arnel-raharinandrasana",
    path: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z",
  },
];

const linkClass =
  "flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 text-slate-600 dark:border-slate-700 dark:text-slate-300";
---

<section class="mb-12 sm:mb-20">
  <div class="hero-layout flex items-start gap-4 sm:gap-6">
    <div
      class="hero-avatar mt-1 flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-orange-500 text-white shadow-[5px_5px_0_#0f172a] dark:shadow-[5px_5px_0_#f97316] sm:h-20 sm:w-20"
      aria-hidden="true"
    >
      <span class="font-mono text-lg font-semibold tracking-wider sm:text-xl">
        {initials}
      </span>
    </div>

    <div class="min-w-0 flex-1">
      <h1 class="hero-name max-w-2xl text-slate-950 dark:text-white">
        {name}
      </h1>
      <p class="mt-3 font-mono text-sm font-semibold uppercase tracking-[0.14em] text-orange-600 dark:text-orange-400">
        {role}
      </p>
    </div>
  </div>

  <p class="mt-8 max-w-2xl text-lg leading-7 text-slate-700 text-pretty dark:text-slate-300 sm:text-xl sm:leading-relaxed">
    {intro}
  </p>

  <ul class="mt-8 flex items-center gap-3 sm:gap-4">
    {socials.map((item) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          title={item.label}
          class={linkClass}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d={item.path} />
          </svg>
        </a>
      </li>
    ))}
    <li>
      <a href="mailto:hello@sadiarnel.me" aria-label="Email" title="Email" class={linkClass}>
        <Mail size={22} stroke-width={1.8} aria-hidden="true" />
      </a>
    </li>
  </ul>
</section>