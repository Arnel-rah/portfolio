---
interface Props {
  name: string;
  initials: string;
  role: string;
  intro: string;
}
const { name, initials, role, intro } = Astro.props;

const links = [
  { label: "GitHub", href: "https://github.com/Arnel-rah" },
  { label: "LinkedIn", href: "#" },
  { label: "Email", href: "mailto:you@example.com" },
];
---
<section class="mb-12">
  <div class="w-16 h-16 rounded-full bg-teal-600/10 dark:bg-teal-400/10 border border-teal-500/20 flex items-center justify-center">
    <span class="font-mono text-base font-semibold text-teal-700 dark:text-teal-300">
      {initials}
    </span>
  </div>

  <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 leading-tight mt-4">
    {name}
  </h1>
  <p class="text-sm font-mono text-teal-600 dark:text-teal-400 mt-1.5">
    {role}
  </p>

  <p class="text-stone-600 dark:text-stone-400 text-base leading-relaxed mt-4 text-pretty">
    {intro}
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium">
    {links.map((l) => (
      <a
        href={l.href}
        target={l.href.startsWith("mailto:") ? undefined : "_blank"}
        rel="noopener noreferrer"
        class="text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 underline underline-offset-4 decoration-stone-300 dark:decoration-stone-700 transition-colors"
      >
        {l.label}
      </a>
    ))}
  </div>
</section>